generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(uuid())
  name     String   // Nome (Instrutor) ou QRA (Aluno)
  username String   @unique // Login único
  senha    String
  role     String   @default("INSTRUCTOR") // INSTRUCTOR | STUDENT
  avatarUrl String? // Foto de perfil
  aiAnalysis String?
  aiAnalysisSimuladoCount Int? @default(0)
  aiAnalysisDate DateTime?
  unlockedBadges String? @default("")
  displayedBadges String? @default("") // JSON não; CSV de ids de brevês (subconjunto de unlockedBadges) escolhidos pelo aluno pra aparecer ao lado da divisa no ranking
  numero   Int?
  answers  Answer[]
  suspendedUntil DateTime?
  isTestUser Boolean  @default(false)
  bonusStreakDays Int @default(0) // Correção administrativa manual da sequência diária (ex.: falha do sistema fez o aluno perder a sequência)
  hasSeenDueloIntro Boolean @default(false) // Já viu o modal de apresentação do modo Duelo
  lastStreakWarningDay String? // YYYY-MM-DD do último aviso "vai perder a sequência" já enviado, pra não repetir no mesmo dia
  pushSubscriptions PushSubscription[]

  @@index([role])
}

model Simulado {
  id                String     @id @default(uuid())
  codigoSala        String?    @unique
  status            String     @default("WAITING") // WAITING | ACTIVE | FINISHED
  tipo              String     @default("LIVE") // LIVE | DAILY | SPECIAL | BLOCO_PROVA
  instructorId      String
  apostilaName      String?
  topics            String?
  difficulty        String     @default("AVANCADO") // Apenas AVANCADO
  isTeamCompetition Boolean    @default(false)
  isRaceMode        Boolean    @default(false) // Modo Corrida: só o 1º acerto geral marca ponto pra equipe
  teamNames         String?    // JSON array com nomes das equipes
  studentTeams      String?    // JSON map { studentId: teamId }
  hasAppealed       Boolean    @default(false)
  createdAt         DateTime   @default(now())
  expiresAt         DateTime?
  questions         Question[]

  @@index([instructorId])
  @@index([tipo, status])
  @@index([tipo, createdAt])
}

model Question {
  id             String   @id @default(uuid())
  simuladoId     String
  simulado       Simulado @relation(fields: [simuladoId], references: [id])
  enunciado      String
  alternativas   String   // JSON array
  correta        Int      // Index
  justificativa  String
  tempoLimite    Int      // Segundos
  status         String   @default("PENDING") // PENDING | ACTIVE | FINISHED
  hasAppeal      Boolean  @default(false)
  appealStatus   String?  // PENDING | ANNULLED | CORRECTED | REJECTED
  appealReason   String?
  appealedBy     String?
  appealResponse String?
  answers        Answer[]
  presentationAnswer Int? // Marcação do instrutor no Modo Apresentação (índice da alternativa que a turma escolheu)
  sourceQuestionId String? // Se esta questão é uma cópia dentro de um Bloco de Provas, aponta para a Question original do simulado diário
  topico String? // Tópico atribuído pela IA na geração, escolhido da lista fixa Apostila.provaTopics (só quando a apostila é matéria de prova)

  @@index([simuladoId])
}

model Answer {
  id          String   @id @default(uuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id])
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  alternativa Int
  tempoGasto  Int
  isCorrect   Boolean
  pontuacao   Int
  isRaffle    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([questionId])
  @@unique([questionId, studentId])
  @@index([isRaffle])
  @@index([studentId, isCorrect])
}

model Apostila {
  id           String   @id @default(uuid())
  title        String
  filePath     String
  instructorId String
  isActive     Boolean  @default(true)
  isProvaSubject Boolean @default(false) // Marcada pelo instrutor: matéria com prova em breve, gera Bloco de Provas
  provaTopics String? // JSON array de strings — lista fixa de tópicos da apostila, extraída pela IA e revisada pelo instrutor
  vadeMecum    String?
  createdAt    DateTime @default(now())
}

// Duelo 1v1 entre dois alunos, com aposta de flexões. Cada linha já é o desafio + o
// resultado + a dívida (sem tabela de ledger separada) — status caminha por
// PENDING_INVITE|DECLINED|EXPIRED|CANCELLED (desafio direto) ou QUEUED|MATCHED (fila
// de pareamento) até ACTIVE (partida em andamento num Simulado tipo "DUELO") e
// FINISHED (resultado gravado). Sem @relation pra User/Apostila/Simulado, seguindo a
// mesma convenção de LiveMatchResult.studentId/Simulado.instructorId (strings soltas).
model Duelo {
  id              String    @id @default(uuid())
  challengerId    String
  challengedId    String?   // null enquanto QUEUED sem par
  apostilaId      String
  apostilaName    String    // snapshot — sobrevive a rename/exclusão da apostila
  flexoesAposta   Int
  questionCount   Int       @default(10)
  status          String    @default("PENDING_INVITE")
  origin          String    @default("CHALLENGE") // CHALLENGE | QUEUE
  simuladoId      String?   @unique // Simulado tipo "DUELO" que hospeda a partida
  winnerId        String?
  loserId         String?
  isDraw          Boolean   @default(false)
  debtPaid        Boolean   @default(false)
  debtPaidAt      DateTime?
  debtClearedByInstructorId String?
  forfeitedById   String?
  createdAt       DateTime  @default(now())
  respondedAt     DateTime?
  finishedAt      DateTime?

  @@index([challengerId])
  @@index([challengedId])
  @@index([status])
  @@index([apostilaId, status])
  @@index([winnerId, status, debtPaid])
  @@index([loserId, status, debtPaid])
}

// Inscrição de push notification de um dispositivo/navegador do usuário (Web Push).
// Um usuário pode ter várias (celular, PC, etc.) — cada endpoint é único por
// navegador/instalação, não por usuário.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model ExclusiveBadge {
  id          String   @id @default(uuid())
  badgeId     String
  userId      String
  simuladoId  String
  createdAt   DateTime @default(now())
}

// Resultado de um aluno em uma sala LIVE de Competição em Equipes, gravado quando o
// instrutor encerra o simulado. Alimenta os brevês "Líder de Equipe" e "Sprint Tático".
model LiveMatchResult {
  id          String   @id @default(uuid())
  simuladoId  String
  studentId   String
  wonTeam     Boolean  @default(false) // esteve na equipe com maior pontuação somada ao encerrar a sala
  raceWins    Int      @default(0) // quantas rodadas do Modo Corrida o aluno venceu nessa sala
  createdAt   DateTime @default(now())

  @@index([studentId])
}

model ChatMessage {
  id            String   @id @default(uuid())
  studentId     String
  role          String   // "user" | "assistant"
  content       String
  apostilaId    String?
  apostilaTitle String?
  createdAt     DateTime @default(now())

  @@index([studentId, apostilaId])
}

model SystemSetting {
  key   String @id
  value String
}

model InventoryItem {
  id          String   @id @default(uuid())
  codigo      Int      @unique
  categoria   String   // Equipamentos, Eletrodomésticos, Móveis, Material de Limpeza, Outros
  descricao   String
  quantidade  Int      @default(1)
  estado      String   @default("Bom") // Novo | Bom | Regular | Danificado | Em Manutenção
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  histories   InventoryHistory[]
}

model InventoryHistory {
  id           String        @id @default(uuid())
  itemId       String?
  item         InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemDesc     String        // Salvo para auditoria mesmo que o item seja removido
  userId       String
  userName     String        // Nome/QRA do usuário que alterou
  userRole     String        // INSTRUCTOR | STUDENT
  actionType   String        // CREATE | UPDATE | DELETE
  changeDetail String        // Detalhe da mudança ("Alterou Estado de Bom para Danificado", etc.)
  createdAt    DateTime      @default(now())
}

model ApostilaAnnotation {
  id           String   @id @default(uuid())
  userId       String
  apostilaId   String
  content      String // O comentário do aluno (post-it)
  highlightData String // JSON contendo o texto marcado, áreas, página etc.
  color        String? // Opcional, para permitir escolher cores (ex: yellow, green, red)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([userId, apostilaId])
}
