# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/server.js

# Database
dev.db
*.db
*.db-shm
*.db-wal
*.sqlite

# Uploads
/public/uploads/
/uploads/

# Worker do PDF.js copiado automaticamente de node_modules (ver scripts/copy_pdf_worker.js)
/public/pdf-worker/

# Logs
/logs/
*.log

# Scripts locais com credenciais
conectar_vps.bat
*.bat
test-claude.ts

# Configuração local do Claude Code (permissões da sessão, não do projeto)
.claude/settings.local.json
